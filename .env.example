# Copy to .env (gitignored). Used by apps/backend and packages/database (dbmate).
# Local values match docker-compose.yml — never put real secrets in this file.

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL 17 (docker-compose maps container 5432 → host 5433)
DATABASE_URL=postgres://pk:pk_local_only@localhost:5433/pahadi_khatki?sslmode=disable
DB_POOL_MAX=10
SLOW_QUERY_MS=200

# Redis 7 (docker-compose maps container 6379 → host 6380)
REDIS_URL=redis://localhost:6380

# HTTP
PORT=4000
HOST=0.0.0.0
# Comma-separated allowed browser origins (CORS + CSRF Origin check)
APP_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3001,http://localhost:5174,http://localhost:8080,http://127.0.0.1:3001,http://127.0.0.1:5174,http://127.0.0.1:8080
# For LAN access, also add the exact http://<LAN-IP>:<frontend-port> origins above.
COOKIE_DOMAIN=localhost

# Auth (Phase 2 uses this). Min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars
# AES-256 key for ADMIN 2FA secrets. Generate: openssl rand -base64 32
TOTP_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP delivery (D-21): mock in dev (code printed to the API console), msg91 after TRAI DLT approval
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Dev-only (D-57 i): comma-separated E.164 phones of active KITCHEN_PARTNER users who may sign in
# through the storefront phone OTP as a full customer (code still verified). MUST stay empty in production.
OTP_DEV_STAFF_BYPASS_PHONES=

# Product images (D-11): local = dev disk stand-in served by the API; r2 = Cloudflare R2 public bucket
API_PUBLIC_URL=http://localhost:4000
# Optional internal address for container workers calling the sandbox API.
API_INTERNAL_URL=
# File storage (D-11, D-58): local (dev disk) | s3 (AWS, recommended) | r2 (Cloudflare)
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=.uploads
# Optional: select an existing active kitchen for the repeatable ten-product demo seed.
# Run pnpm db:demo:status to see codes; required only when multiple kitchens exist.
DEMO_KITCHEN_CODE=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Private documents — invoices, labels (D-11); 5-min signed URLs
R2_PRIVATE_BUCKET=
LOCAL_PRIVATE_UPLOADS_DIR=.uploads-private
# AWS S3 (STORAGE_DRIVER=s3) — one bucket: products/* public-read, private/* signed links only.
# Setup + checks: docs/ops/s3-storage.md (pnpm --filter @pk/backend s3:setup --apply / s3:check)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional CloudFront / custom domain for product images (empty = the bucket's S3 URL)
AWS_S3_PUBLIC_BASE_URL=

# Payments (Phase 5): mock = dev/CI stand-in (refused in production), razorpay = real API,
# direct_upi = our own apps/payment service (D-59)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Different from the key secret (Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Direct UPI (D-59) — store side. Same values as the service's PAYMENT_API_KEY_ID/_SECRET/PAYMENT_WEBHOOK_SECRET.
DIRECT_UPI_API_URL=http://localhost:4100/v1
DIRECT_UPI_PUBLIC_URL=http://localhost:4100
DIRECT_UPI_KEY_ID=
# openssl rand -hex 32 (each)
DIRECT_UPI_KEY_SECRET=
DIRECT_UPI_WEBHOOK_SECRET=

# Direct UPI service (apps/payment) — delete this block if you remove the service.
PAYMENT_PORT=4100
# Its OWN database (not the store's)
PAYMENT_DATABASE_URL=postgres://pk:pk_local_only@localhost:5435/pk_payment?sslmode=disable
PAYMENT_DB_SSL=false
PAYMENT_PUBLIC_URL=http://localhost:4100
PAYMENT_STOREFRONT_URL=http://localhost:3000
# upi_test_… / upi_live_… + 8+ letters/digits
PAYMENT_API_KEY_ID=
PAYMENT_API_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/razorpay
# Business current-account VPA (never a personal UPI id)
UPI_VPA=
UPI_PAYEE_NAME=Pahadi Khatki
UPI_LATE_GRACE_MINUTES=30
# Channel 1: SES inbound → SNS (docs/ops/direct-upi.md)
UPI_ALERT_SNS_TOPIC_ARN=
UPI_ALERT_EMAIL_RECIPIENT=
# DKIM signing domains of your bank, comma separated (e.g. hdfcbank.net)
UPI_BANK_EMAIL_DOMAINS=
# Channel 2: Android observer. openssl rand -base64 32
UPI_DEVICE_KEK=
# Bank SMS headers, comma separated (e.g. HDFCBK)
UPI_BANK_SMS_SENDERS=
# /dev/alerts simulator (local only; refused in production)
PAYMENT_DEV_TOOLS=false

# Logistics (Phase 6): sandbox = Shiprocket stand-in inside the API at /api/v1/dev/shiprocket/
# (dev/CI, refused in production; the worker reaches it via API_PUBLIC_URL), shiprocket = real API
SHIPPING_PROVIDER=sandbox
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external/
# Shiprocket API user (Settings → API → Configure), NOT the panel login
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Security token on the webhook (Settings → API → Webhooks) — URL: <API>/api/v1/webhooks/courier-tracking
SHIPROCKET_WEBHOOK_TOKEN=
WORKER_CONCURRENCY=5

# Web Push for the partner PWA (Phase 7): `npx web-push generate-vapid-keys`. All three or none —
# unset = push off, partner alerts go to WhatsApp (Phase 8). Subject: mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Messages (Phase 8): mock = Redis outbox + /api/v1/dev/messages (dev/CI, refused in production)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret (webhook signature) + our verify token for the GET challenge
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
SMS_PROVIDER=mock
# JSON map template → MSG91 DLT flow id, e.g. {"order_confirmed":"64f…","out_for_delivery":"…"}
MSG91_SMS_TEMPLATES=
# Comma-separated E.164 admin numbers + e-mail fallback for ops alerts
ADMIN_ALERT_PHONES=
ADMIN_ALERT_EMAIL=
STOREFRONT_PUBLIC_URL=http://localhost:3000
CUSTOMER_MESSAGE_LANGUAGE=en

# Storefront cache revalidation after catalog/stock edits (set both or neither; same secret in apps/storefront)
STOREFRONT_REVALIDATE_URL=
REVALIDATE_SECRET=

# Meta Conversions API (Phase 4) — empty = disabled
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Error tracking (optional in development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Git SHA of the deploy — tags Sentry events with the release (docs/ops/sentry.md)
RELEASE=

# Admin 2FA (Phase 10 §10.1): always on in production; set true to enforce TOTP for ADMIN locally
# ADMIN_TOTP_REQUIRED=true

# Pre-launch lock (coming-soon launch). Production defaults to `coming-soon`: the storefront serves
# only /coming-soon (`/` shows it, everything else 404) and the admin build shows only a 404.
# Set `live` on launch day. Development is never locked unless set to `coming-soon`.
# LAUNCH_MODE=coming-soon        # storefront, runtime (restart to apply)
# VITE_LAUNCH_MODE=coming-soon   # admin, build time (rebuild to apply)

# Full Docker stack (docker-compose.prod.yml). Public values are passed at BUILD time.
# Local npm dev can share it by setting DATABASE_URL host port 5435 and REDIS_URL port 6381.
POSTGRES_DB=pahadi_khatki
DOCKER_API_PUBLIC_URL=http://localhost:4001
DOCKER_STOREFRONT_URL=http://localhost:3001
DOCKER_BROWSER_API_URL=
# Set this together with REVALIDATE_SECRET to refresh Docker storefront caches after catalog edits.
DOCKER_REVALIDATE_URL=
# DOCKER_REVALIDATE_URL=http://storefront:3000/api/revalidate
# LAN access: replace localhost above with the machine's LAN IP and expose these app ports.
# HOST_API_PORT=0.0.0.0:4001
# HOST_STOREFRONT_PORT=0.0.0.0:3001
# HOST_ADMIN_PORT=0.0.0.0:5174
# Keep PostgreSQL/Redis bound to loopback. Do not change volume names casually.
