# Public values only — everything prefixed VITE_ is shipped to the browser.
# Blank = same-origin browser API; Vite/nginx proxies requests to the backend.
VITE_API_URL=
INTERNAL_API_URL=http://127.0.0.1:4000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Git SHA of the deploy (Sentry release + source maps, docs/ops/sentry.md)
VITE_RELEASE=
