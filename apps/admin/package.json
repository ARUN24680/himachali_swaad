{
  "name": "@pk/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-i18n.mjs",
    "test:e2e": "playwright test && playwright test -c playwright.pwa.config.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "test:pwa": "playwright test -c playwright.pwa.config.ts",
    "test:pwa:perf": "PK_PWA_PERF=1 playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@pk/shared": "workspace:*",
    "@pk/ui": "workspace:*",
    "@sentry/react": "11.4.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "1.51.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@pk/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
