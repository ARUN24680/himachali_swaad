{
  "name": "@pk/payment",
  "private": true,
  "type": "module",
  "description": "Direct UPI payment service (D-59). Self-contained: delete this folder and set PAYMENT_GATEWAY=razorpay to remove it.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "node scripts/build.mjs && vite build --config web/vite.config.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "dbmate --env-file ../../.env --env PAYMENT_DATABASE_URL --migrations-dir ./migrations --no-dump-schema up",
    "db:down": "dbmate --env-file ../../.env --env PAYMENT_DATABASE_URL --migrations-dir ./migrations --no-dump-schema down",
    "db:status": "dbmate --env-file ../../.env --env PAYMENT_DATABASE_URL --migrations-dir ./migrations --no-dump-schema status",
    "admin": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env scripts/admin.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.5",
    "mailauth": "7.2.0",
    "mailparser": "3.9.38",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@pk/shared": "workspace:*",
    "@pk/tsconfig": "workspace:*",
    "@pk/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dbmate": "2.37.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.51.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
