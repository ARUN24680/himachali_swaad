# Public values only — NEXT_PUBLIC_* is shipped to the browser.
# Blank = browser uses the current page's host (works on localhost and LAN).
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Git SHA of the deploy (Sentry release + source maps, docs/ops/sentry.md)
NEXT_PUBLIC_RELEASE=
# Must match backend API_PUBLIC_URL + /dev-assets locally; use the R2 CDN in production.
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:4000/dev-assets

# ── Server-only (never NEXT_PUBLIC_) ──
# Shared with the backend's REVALIDATE_SECRET (min 32 chars). Generate: openssl rand -base64 48
REVALIDATE_SECRET=

# ── Analytics (Phase 4 §4.8) — load ONLY after consent; empty = never load ──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Seller / legal facts (src/config/site.ts). Empty = shown as "Pending" on the site. ──
# Q-02: legal entity holding FSSAI + GST
NEXT_PUBLIC_SELLER_LEGAL_NAME=
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_FSSAI_NO=
NEXT_PUBLIC_SELLER_GSTIN=
NEXT_PUBLIC_SELLER_PHONE=
NEXT_PUBLIC_SELLER_EMAIL=
# Digits with country code, e.g. 919876543210
NEXT_PUBLIC_SELLER_WHATSAPP=
NEXT_PUBLIC_SELLER_SUPPORT_HOURS=
NEXT_PUBLIC_SELLER_GRIEVANCE_NAME=
NEXT_PUBLIC_SELLER_GRIEVANCE_DESIGNATION=
NEXT_PUBLIC_SELLER_GRIEVANCE_EMAIL=
NEXT_PUBLIC_SELLER_GRIEVANCE_PHONE=

# ── Policy facts tied to open questions (display text) ──
# Q-03, e.g. "₹999"
NEXT_PUBLIC_POLICY_FREE_SHIPPING=
# Q-04
NEXT_PUBLIC_POLICY_RTO_REFUND=
NEXT_PUBLIC_POLICY_DAMAGE_CLAIM_WINDOW=
NEXT_PUBLIC_POLICY_DAMAGE_EVIDENCE=
NEXT_PUBLIC_POLICY_REFUND_TIMELINE=
NEXT_PUBLIC_POLICY_LAST_UPDATED=
