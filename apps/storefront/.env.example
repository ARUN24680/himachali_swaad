# Public values only — NEXT_PUBLIC_* is shipped to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Product image CDN (R2 public bucket domain). Empty locally → backend /dev-assets.
NEXT_PUBLIC_ASSETS_BASE_URL=

# ── Server-only (never NEXT_PUBLIC_) ──
# Shared with the backend's REVALIDATE_SECRET (min 32 chars). Generate: openssl rand -base64 48
REVALIDATE_SECRET=
