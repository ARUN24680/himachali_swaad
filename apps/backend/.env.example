# ============================================================
# @pk/backend — Local Development Environment
# Copy this to .env and fill in real values
# NEVER commit .env to git!
# ============================================================

# Database (docker-compose local)
DATABASE_URL=postgres://pk:pk_local_only@localhost:5433/pahadi_khatki
DB_POOL_MAX=10
SLOW_QUERY_MS=200

# Redis (docker-compose local)
REDIS_URL=redis://localhost:6380

# App
NODE_ENV=development
PORT=8080
PROCESS_NAME=api-server

# CORS
APP_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_DOMAIN=localhost

# Auth — change this to any random 32+ char string
JWT_SECRET=change-me-to-a-random-32-char-secret-string

# Sentry (optional in dev — leave blank)
SENTRY_DSN=
