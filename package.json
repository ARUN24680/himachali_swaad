{
  "name": "pahadi-khatki",
  "private": true,
  "description": "Pahadi Khatki — Himachali non-veg pickle e-commerce & operations monorepo",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "dev:backend": "turbo run dev --filter=@pk/backend",
    "dev:storefront": "turbo run dev --filter=@pk/storefront",
    "dev:admin": "turbo run dev --filter=@pk/admin",
    "db:new": "pnpm --filter @pk/database db:new",
    "db:up": "pnpm --filter @pk/database db:up",
    "db:down": "pnpm --filter @pk/database db:down",
    "db:status": "pnpm --filter @pk/database db:status"
  }
}