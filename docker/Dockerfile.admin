# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app

FROM base AS builder
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
# Pre-launch lock: empty/coming-soon = the build shows only a 404; `live` = the full admin app
ARG VITE_LAUNCH_MODE=
ENV VITE_LAUNCH_MODE=$VITE_LAUNCH_MODE
# Copy workspace manifests and shared configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY playwright.viewports.ts* ./
# Copy workspace packages
COPY packages ./packages
# Copy admin app
COPY apps/admin ./apps/admin

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build Vite SPA into apps/admin/dist
ENV NODE_OPTIONS="--max-old-space-size=1536"
RUN pnpm --filter @pk/admin build

FROM nginx:alpine AS runner
# Copy custom nginx SPA configuration
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf

# Copy Vite build output to Nginx document root
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
