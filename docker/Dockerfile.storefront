# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app

FROM base AS builder
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3001
ARG NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:4001/dev-assets
ARG INTERNAL_API_URL=http://backend-api:4000
# Seller / legal / policy / social / analytics facts (audit R-1, M-5): NEXT_PUBLIC_* is inlined at build time,
# so they must be build args — a runtime env on the container would never reach the pages.
ARG NEXT_PUBLIC_SELLER_LEGAL_NAME=
ARG NEXT_PUBLIC_SELLER_ADDRESS=
ARG NEXT_PUBLIC_SELLER_FSSAI_NO=
ARG NEXT_PUBLIC_SELLER_GSTIN=
ARG NEXT_PUBLIC_SELLER_PHONE=
ARG NEXT_PUBLIC_SELLER_EMAIL=
ARG NEXT_PUBLIC_SELLER_WHATSAPP=
ARG NEXT_PUBLIC_SELLER_SUPPORT_HOURS=
ARG NEXT_PUBLIC_SELLER_GRIEVANCE_NAME=
ARG NEXT_PUBLIC_SELLER_GRIEVANCE_DESIGNATION=
ARG NEXT_PUBLIC_SELLER_GRIEVANCE_EMAIL=
ARG NEXT_PUBLIC_SELLER_GRIEVANCE_PHONE=
ARG NEXT_PUBLIC_POLICY_FREE_SHIPPING=
ARG NEXT_PUBLIC_POLICY_RTO_REFUND=
ARG NEXT_PUBLIC_POLICY_DAMAGE_CLAIM_WINDOW=
ARG NEXT_PUBLIC_POLICY_DAMAGE_EVIDENCE=
ARG NEXT_PUBLIC_POLICY_REFUND_TIMELINE=
ARG NEXT_PUBLIC_POLICY_LAST_UPDATED=
ARG NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
ARG NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
ARG NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
ARG NEXT_PUBLIC_GA4_ID=
ARG NEXT_PUBLIC_META_PIXEL_ID=
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ASSETS_BASE_URL=$NEXT_PUBLIC_ASSETS_BASE_URL \
    INTERNAL_API_URL=$INTERNAL_API_URL \
    NEXT_PUBLIC_SELLER_LEGAL_NAME=$NEXT_PUBLIC_SELLER_LEGAL_NAME \
    NEXT_PUBLIC_SELLER_ADDRESS=$NEXT_PUBLIC_SELLER_ADDRESS \
    NEXT_PUBLIC_SELLER_FSSAI_NO=$NEXT_PUBLIC_SELLER_FSSAI_NO \
    NEXT_PUBLIC_SELLER_GSTIN=$NEXT_PUBLIC_SELLER_GSTIN \
    NEXT_PUBLIC_SELLER_PHONE=$NEXT_PUBLIC_SELLER_PHONE \
    NEXT_PUBLIC_SELLER_EMAIL=$NEXT_PUBLIC_SELLER_EMAIL \
    NEXT_PUBLIC_SELLER_WHATSAPP=$NEXT_PUBLIC_SELLER_WHATSAPP \
    NEXT_PUBLIC_SELLER_SUPPORT_HOURS=$NEXT_PUBLIC_SELLER_SUPPORT_HOURS \
    NEXT_PUBLIC_SELLER_GRIEVANCE_NAME=$NEXT_PUBLIC_SELLER_GRIEVANCE_NAME \
    NEXT_PUBLIC_SELLER_GRIEVANCE_DESIGNATION=$NEXT_PUBLIC_SELLER_GRIEVANCE_DESIGNATION \
    NEXT_PUBLIC_SELLER_GRIEVANCE_EMAIL=$NEXT_PUBLIC_SELLER_GRIEVANCE_EMAIL \
    NEXT_PUBLIC_SELLER_GRIEVANCE_PHONE=$NEXT_PUBLIC_SELLER_GRIEVANCE_PHONE \
    NEXT_PUBLIC_POLICY_FREE_SHIPPING=$NEXT_PUBLIC_POLICY_FREE_SHIPPING \
    NEXT_PUBLIC_POLICY_RTO_REFUND=$NEXT_PUBLIC_POLICY_RTO_REFUND \
    NEXT_PUBLIC_POLICY_DAMAGE_CLAIM_WINDOW=$NEXT_PUBLIC_POLICY_DAMAGE_CLAIM_WINDOW \
    NEXT_PUBLIC_POLICY_DAMAGE_EVIDENCE=$NEXT_PUBLIC_POLICY_DAMAGE_EVIDENCE \
    NEXT_PUBLIC_POLICY_REFUND_TIMELINE=$NEXT_PUBLIC_POLICY_REFUND_TIMELINE \
    NEXT_PUBLIC_POLICY_LAST_UPDATED=$NEXT_PUBLIC_POLICY_LAST_UPDATED \
    NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=$NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL \
    NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=$NEXT_PUBLIC_SOCIAL_FACEBOOK_URL \
    NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=$NEXT_PUBLIC_SOCIAL_YOUTUBE_URL \
    NEXT_PUBLIC_GA4_ID=$NEXT_PUBLIC_GA4_ID \
    NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
# Copy workspace manifests and shared configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY playwright.viewports.ts* ./
# Copy workspace packages
COPY packages ./packages
# Copy storefront application
COPY apps/storefront ./apps/storefront

# Install dependencies
RUN pnpm install --frozen-lockfile

# Optimize Node memory for t2/t3.micro instances (caps heap to fit in available RAM)
ARG NODE_OPTIONS="--max-old-space-size=768"
ENV NEXT_OUTPUT_STANDALONE=true \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=$NODE_OPTIONS
# Next 16 Turbopack compiles natively in seconds with minimal memory footprint
RUN pnpm --filter @pk/storefront build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apk add --no-cache curl

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone output and static assets
COPY --from=builder /app/apps/storefront/.next/standalone ./
COPY --from=builder /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=builder /app/apps/storefront/public ./apps/storefront/public

EXPOSE 3000

CMD ["node", "apps/storefront/server.js"]
