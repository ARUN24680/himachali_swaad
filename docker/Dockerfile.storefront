# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app

FROM base AS builder
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3001
ARG NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:4001/dev-assets
ARG INTERNAL_API_URL=http://backend-api:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ASSETS_BASE_URL=$NEXT_PUBLIC_ASSETS_BASE_URL \
    INTERNAL_API_URL=$INTERNAL_API_URL
# Copy workspace manifests and shared configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY playwright.viewports.ts* ./
# Copy workspace packages
COPY packages ./packages
# Copy storefront application
COPY apps/storefront ./apps/storefront

# Install dependencies
RUN pnpm install --frozen-lockfile

# Keep Docker builds predictable on hosts also running the application stack.
# This caps each Node heap, not total build memory (native allocations/workers).
# Override with docker compose build --build-arg NODE_OPTIONS=... storefront.
ARG NODE_OPTIONS="--max-old-space-size=1536"
ENV NEXT_OUTPUT_STANDALONE=true \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_BUILD_LOW_MEMORY=true \
    NODE_OPTIONS=$NODE_OPTIONS
# Next 16 defaults to Turbopack; use Webpack's memory optimizations for Docker.
RUN pnpm --filter @pk/storefront build --webpack

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apk add --no-cache curl

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone output and static assets
COPY --from=builder /app/apps/storefront/.next/standalone ./
COPY --from=builder /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=builder /app/apps/storefront/public ./apps/storefront/public

EXPOSE 3000

CMD ["node", "apps/storefront/server.js"]
